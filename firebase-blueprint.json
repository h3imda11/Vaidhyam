{
  "entities": {
    "User": {
      "title": "User",
      "description": "Patient or administrator user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["patient", "admin"] },
        "gender": { "type": "string", "maxLength": 20 },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "assignedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Ayurvedic physician profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "qualification": { "type": "string" },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "experienceYears": { "type": "number" },
        "languages": { "type": "string" },
        "consultationFee": { "type": "number" },
        "photoUrl": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "qualification", "specialization"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Doctor consultation appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientEmail": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "appointmentType": { "type": "string" },
        "symptoms": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "rescheduled", "no-show"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "pay_at_clinic"] },
        "fee": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "doctorId", "date", "timeSlot", "status"]
    },
    "PdcPackage": {
      "title": "PdcPackage",
      "description": "Post-delivery care package offering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "durationDays": { "type": "number" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "inclusions": { "type": "string" },
        "exclusions": { "type": "string" },
        "accommodation": { "type": "string" },
        "food": { "type": "string" },
        "motherAndBabyOption": { "type": "boolean" },
        "sessionsCount": { "type": "number" },
        "consultationsIncluded": { "type": "number" },
        "homeCareAvailable": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "durationDays", "price"]
    },
    "PdcBooking": {
      "title": "PdcBooking",
      "description": "Post-delivery care enrollment booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientEmail": { "type": "string" },
        "packageId": { "type": "string" },
        "packageName": { "type": "string" },
        "startDate": { "type": "string" },
        "preferredConsultationDate": { "type": "string" },
        "careRequirement": { "type": "string" },
        "preferredLocation": { "type": "string" },
        "additionalNotes": { "type": "string" },
        "price": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "bookingStatus": { "type": "string", "enum": ["pending", "confirmed", "active", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "packageId", "startDate", "bookingStatus"]
    },
    "Treatment": {
      "title": "Treatment",
      "description": "Ayurvedic therapy and treatment program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "shortDescription": { "type": "string" },
        "suitableFor": { "type": "string" },
        "approach": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "price": { "type": "number" },
        "requiresAssessment": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "category"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Patient enquiry and contact message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "message"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetRole": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message"]
    },
    "Availability": {
      "title": "Availability",
      "description": "Doctor consultation schedule config",
      "type": "object",
      "properties": {
        "doctorId": { "type": "string" },
        "workingDays": { "type": "string" },
        "workingHours": { "type": "string" },
        "slotDurationMinutes": { "type": "number" },
        "breakPeriods": { "type": "string" },
        "blockedDates": { "type": "string" },
        "maxAppointmentsPerDay": { "type": "number" }
      },
      "required": ["doctorId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Clinic settings and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "consultationFee": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["id", "businessName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "List of authorized administrator UIDs"
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Registered doctors and clinicians"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Consultation appointments"
    },
    "/pdc_packages/{packageId}": {
      "schema": { "$ref": "#/entities/PdcPackage" },
      "description": "Post-delivery care packages"
    },
    "/pdc_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/PdcBooking" },
      "description": "Bookings for post-delivery care"
    },
    "/treatments/{treatmentId}": {
      "schema": { "$ref": "#/entities/Treatment" },
      "description": "Clinical Ayurvedic treatments"
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Contact messages and enquiries"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Patient and admin notifications"
    },
    "/availability/{doctorId}": {
      "schema": { "$ref": "#/entities/Availability" },
      "description": "Doctor scheduling availability and blocked dates"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Clinic contact and global configuration"
    }
  }
}
